{
  "manifest_version": 2,
  "name": "Leetify for Codeforces — Firefox",
  "version": "0.2.0",
  "description": "A focused Codeforces workspace for solving, testing, notes, and drafts.",
  "author": "Leetify contributors",
  "homepage_url": "https://github.com/lostumbrella125-a11y/leetify-for-firefox",
  "icons": {
    "16": "icons/leetify-16.png",
    "32": "icons/leetify-32.png",
    "48": "icons/leetify-48.png",
    "96": "icons/leetify-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "leetify-firefox@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "https://codeforces.com/*",
    "https://*.codeforces.com/*"
  ],
  "browser_action": {
    "default_title": "Toggle Leetify workspace",
    "default_icon": {
      "16": "icons/leetify-16.png",
      "32": "icons/leetify-32.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*"
      ],
      "js": ["src/core.js", "src/runner.js", "src/testcases.js", "src/history.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
